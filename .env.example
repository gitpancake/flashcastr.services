# ===== Shared (all services) =====
RABBITMQ_URL=amqp://user:pass@localhost:5672
NODE_ENV=development
LOG_LEVEL=info
METRICS_PORT=9090

# ===== flash-engine =====
PROXY_LIST=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
FALLBACK_PROXY_LIST=http://backup:8080
CRON_SCHEDULE=*/5 * * * *
# DATABASE_URL (shared with database-engine)

# ===== image-engine =====
PINATA_JWT=eyJhbGc...
IMAGE_ENGINE_SOURCE=rabbitmq          # or "jobs" — selects RabbitMQ flash.received consumption vs claiming Postgres pin jobs
CONSUMER_CONCURRENCY=5
CONSUMER_RATE_LIMIT=250
CONSUMER_MAX_ATTEMPTS=10          # retryable failures before a message is dead-lettered (all consumers; default 5)
# PROXY_LIST (shared with flash-engine)

# ===== database-engine =====
DATABASE_URL=postgresql://user:pass@localhost:5432/flashcastr
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
BATCH_SIZE=50
BATCH_FLUSH_INTERVAL_MS=5000
BATCH_RETRY_DELAY_MS=5000        # wait before requeueing a batch whose write or publish failed

# ===== neynar-engine =====
# DATABASE_URL (shared with database-engine)
# DB_POOL_MAX=5 (lower for neynar-engine)
NEYNAR_API_KEY=your-neynar-api-key
SIGNER_ENCRYPTION_KEY=your-hex-encryption-key
RETRY_INTERVAL_MS=300000

# ===== agent-invaders =====
# DATABASE_URL (shared; creates schemas langgraph + langgraph_store and tables action_log, inbound_casts)
# NEYNAR_API_KEY (shared with neynar-engine; also used as x-api-key for the Neynar hub)
FIREWORKS_API_KEY=fw_...
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3
HUB_HTTP_URL=https://hub-api.neynar.com
FARCASTER_FID=12345
FARCASTER_SIGNER_PRIVATE_KEY=0x...
FARCASTER_CHANNEL_ID=invaders
NEYNAR_WEBHOOK_SECRET=optional-neynar-webhook-secret
DAILY_DIGEST_CRON=0 9 * * *
MENTION_POLL_INTERVAL_MS=300000
ADMIN_TOKEN=optional-bearer-token-for-POST-/admin/digest
TAVILY_API_KEY=
EXTRA_RSS_FEEDS=

# ===== api (optional hardening) =====
# API_KEY guards setUserAutoCast/deleteUser (x-api-key header). Unset = always rejected.
API_KEY=your-api-key
TRUST_PROXY_HOPS=1                   # proxies in front of the api (Railway=1); drives req.ip for rate limits
RATE_LIMIT_SIGNUP_PER_10MIN=5        # initiateSignup per client IP
RATE_LIMIT_IDENTIFICATION_PER_MIN=60 # saveFlashIdentification per client IP
CORS_ORIGINS=                        # comma-separated allowlist; empty = allow all (current behaviour)
GRAPHQL_INTROSPECTION=true
