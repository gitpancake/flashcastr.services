# ===== Shared (all services) =====
RABBITMQ_URL=amqp://user:pass@localhost:5672
NODE_ENV=development
LOG_LEVEL=info
METRICS_PORT=9090

# ===== flash-engine =====
PROXY_LIST=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
FALLBACK_PROXY_LIST=http://backup:8080
CRON_SCHEDULE=*/5 * * * *

# ===== image-engine =====
PINATA_JWT=eyJhbGc...
CONSUMER_CONCURRENCY=5
CONSUMER_RATE_LIMIT=250
# PROXY_LIST (shared with flash-engine)

# ===== database-engine =====
DATABASE_URL=postgresql://user:pass@localhost:5432/flashcastr
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
BATCH_SIZE=50
BATCH_FLUSH_INTERVAL_MS=5000

# ===== neynar-engine =====
# DATABASE_URL (shared with database-engine)
# DB_POOL_MAX=5 (lower for neynar-engine)
NEYNAR_API_KEY=your-neynar-api-key
SIGNER_ENCRYPTION_KEY=your-hex-encryption-key
RETRY_INTERVAL_MS=300000

# ===== agent-flashcastr =====
# Standalone reply bot — NO RABBITMQ_URL (broker-less). Replies to Farcaster
# mentions of @flashcastr, runs a domain knowledge base, pulls context from
# OpenViking directly. Deploy on Railway with its OWN Postgres.
#
# Own agent Postgres (separate from database-engine's DB):
DATABASE_URL=postgresql://user:pass@localhost:5432/agent_flashcastr
# Claude auth — set ONE. ANTHROPIC_API_KEY (API billing, x-api-key) takes
# precedence; else CLAUDE_CODE_OAUTH_TOKEN (Claude.ai subscription, Bearer):
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token
# OpenViking — direct context access (this agent holds the creds itself):
OPENVIKING_URL=https://openviking.example.com
OPENVIKING_API_KEY=your-ov-api-key
OPENVIKING_BASIC_USER=your-ov-basic-user
OPENVIKING_BASIC_PASS=your-ov-basic-pass
# Farcaster publish + inbound webhook:
# NEYNAR_API_KEY (shared with neynar-engine)
FARCASTER_ENCRYPTION_KEY=your-hex-key-for-decrypting-the-signer
HUB_HTTP_URL=https://hub-api.neynar.com
NEYNAR_WEBHOOK_SECRET=optional-unset-falls-back-to-15min-poll
PORT=8080
# Flashcastr API + scraper sources:
FLASHCASTR_API_URL=https://flashcastr.example.com/graphql
FLASHCASTR_IPFS_GATEWAY=https://ipfs.example.com
AWAZLEON_USER=scraper-user
AWAZLEON_PASS=scraper-pass
# TIMEZONE=America/Vancouver (optional; defaults applied)
