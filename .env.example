# ===== Shared (all services) =====
NODE_ENV=development
LOG_LEVEL=info
METRICS_PORT=9090
DATABASE_URL=postgresql://user:pass@localhost:5432/flashcastr
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000

# ===== flash-engine =====
PROXY_LIST=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
FALLBACK_PROXY_LIST=http://backup:8080
CRON_SCHEDULE=*/5 * * * *
OFF_PEAK_MIN_INTERVAL_MS=600000   # min ms between off-peak (23:00-06:00 Paris) polls

# ===== image-engine =====
PINATA_JWT=eyJhbGc...
IMAGE_STORE=pinata               # pinata | b2 — which pinner writes new flashes; b2 also requires the B2_* vars below
B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=flashcastr-images
B2_PUBLIC_BASE=https://f004.backblazeb2.com/file/flashcastr-images
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
CONSUMER_CONCURRENCY=5
CONSUMER_RATE_LIMIT=250
CONSUMER_MAX_ATTEMPTS=10          # attempts before a pin job goes dead (stays in flash_jobs, never claimed; default 5, image-engine overrides to 10)
# PROXY_LIST (shared with flash-engine)

# ===== scripts/promote-keep-set.ts =====
# Promote key only — whole-bucket access, never the image-engine key (which
# is confined to feed/ and cannot write keep/).
B2_PROMOTE_KEY_ID=your-b2-promote-key-id
B2_PROMOTE_KEY=your-b2-promote-application-key
PINATA_GATEWAY=https://fuchsia-rich-lungfish-648.mypinata.cloud/ipfs  # dedicated gateway; ~10x faster than gateway.pinata.cloud for legacy-row fetches
PROMOTE_CONCURRENCY=8              # candidates copied in parallel
PROMOTE_RATE_LIMIT=600             # requests/min against B2 + the Pinata gateway during the sweep
# B2_S3_ENDPOINT, B2_REGION, B2_BUCKET (shared with image-engine, see above)

# ===== neynar-engine =====
# DATABASE_URL, DB_POOL_* (see Shared section above)
NEYNAR_API_KEY=your-neynar-api-key
SIGNER_ENCRYPTION_KEY=your-hex-encryption-key
RETRY_INTERVAL_MS=300000
CAST_JOB_CONCURRENCY=5            # parallel claim loops on flash_jobs stage 'cast'
CAST_JOB_LEASE_MS=60000           # a claimed job is reclaimable after this if the worker dies
CAST_JOB_MAX_ATTEMPTS=5           # attempts before a cast job is dead (stays in flash_jobs, never claimed)
CAST_JOB_POLL_INTERVAL_MS=1000    # idle sleep between claims

# ===== agent-invaders =====
# DATABASE_URL (shared; creates schemas langgraph + langgraph_store and tables action_log, inbound_casts)
# NEYNAR_API_KEY (shared with neynar-engine; also used as x-api-key for the Neynar hub)
FIREWORKS_API_KEY=fw_...
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3
HUB_HTTP_URL=https://hub-api.neynar.com
FARCASTER_FID=12345
FARCASTER_SIGNER_PRIVATE_KEY=0x...
FARCASTER_CHANNEL_ID=invaders
NEYNAR_WEBHOOK_SECRET=optional-neynar-webhook-secret
DAILY_DIGEST_CRON=0 9 * * *
MENTION_POLL_INTERVAL_MS=300000
ADMIN_TOKEN=optional-bearer-token-for-POST-/admin/digest
TAVILY_API_KEY=
EXTRA_RSS_FEEDS=

# ===== api (optional hardening) =====
# API_KEY guards setUserAutoCast/deleteUser (x-api-key header). Unset = always rejected.
API_KEY=your-api-key
TRUST_PROXY_HOPS=1                   # proxies in front of the api (Railway=1); drives req.ip for rate limits
RATE_LIMIT_SIGNUP_PER_10MIN=5        # initiateSignup per client IP
RATE_LIMIT_IDENTIFICATION_PER_MIN=60 # saveFlashIdentification per client IP
CORS_ORIGINS=                        # comma-separated allowlist; empty = allow all (current behaviour)
GRAPHQL_INTROSPECTION=true
